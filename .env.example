# Copy to .env for local development. Never commit a real .env.
# Local-only values for the database started by tools/dev/docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://trucker:trucker-local-only@localhost:5432/trucker_dev

# Sign-in and registration: LOCAL DEVELOPMENT ONLY. Production refuses both values.
# development-display returns the one-time code to a caller on this machine instead of sending
# a text message (no message supplier is chosen). It needs the database on this machine.
SIGN_IN_CODE_DELIVERY=development-display
# demonstration records that a person saw placeholder terms. It is not acceptance of legal terms.
REGISTRATION_TERMS=demonstration
# The web application's own switch. Without it the web application never asks the API for a
# code and never shows one. With it, a code is shown only to a browser on this machine: the
# connection must come from this machine, must not have been forwarded, and must be addressed
# to localhost. Production refuses to start with it set.
TRUCKER_DEVELOPMENT_CODE_DISPLAY=local-visitors
# Where the web application finds the API (read by apps/web on the server only).
TRUCKER_API_URL=http://localhost:3000

# Organisations: LOCAL DEVELOPMENT ONLY values below.
# The API must not run as the migration role (DATABASE_URL), because that role owns the tables
# and row security does not bind it. After `npm run db:migrate`, run `npm run db:app-role`: it
# creates a local login for the API's role and prints the line to put here. Until this is set,
# organisation endpoints answer 503 organisation_access_closed. The migration role needs
# CREATEROLE for this (an existing local role: ALTER ROLE trucker CREATEROLE, as postgres).
APP_DATABASE_URL=postgres://trucker_api_local:trucker-api-local-only@localhost:5432/trucker_dev
# No real country is enabled. To try organisation onboarding locally, load the fictional
# countries with:  TRUCKER_LOCAL_FIXTURES=local-development-only npm run db:fixtures
# That marks this database local-development (a production database can never be so marked)
# and this setting lets the API count them as open. Production refuses it.
COUNTRY_FIXTURES=local-development
# Development defaults; production must set both explicitly after review.
# ORGANISATION_CREATION_LIMIT=5
# RETRY_KEY_RETENTION_HOURS=24
