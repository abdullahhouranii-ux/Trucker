{
  "name": "@trucker/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Trucker web application. Foundation: design tokens, English, Arabic and Urdu with right-to-left layout, public home page.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "puppeteer-core": "25.17.0"
  }
}
