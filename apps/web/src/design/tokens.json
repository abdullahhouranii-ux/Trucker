{
  "version": "0.3.0",
  "status": "provisional",
  "note": "Direction A (Signage) with numbered steps: a working direction, not an approved design. Sizes are in rem so text follows the reader's text size.",
  "color": {
    "blue": "#0B4EA2",
    "green": "#0B6B4A",
    "asphalt": "#1F2328",
    "yellow": "#F6C700",
    "red": "#B3261E",
    "ground": "#EDEFF1",
    "surface": "#FFFFFF",
    "text": "#1F2328",
    "muted": "#4A525C",
    "border": "#6B737C",
    "hairline": "#C5CAD0",
    "blue-tint": "#E3ECF8",
    "green-tint": "#DFF0E7",
    "yellow-tint": "#FFF3B8",
    "red-tint": "#FBE4E2"
  },
  "contrast": [
    {
      "foreground": "surface",
      "background": "blue",
      "minimum": 4.5,
      "use": "text on a sign plate"
    },
    {
      "foreground": "surface",
      "background": "green",
      "minimum": 4.5,
      "use": "text on a signed step"
    },
    { "foreground": "surface", "background": "asphalt", "minimum": 4.5, "use": "text on headers" },
    { "foreground": "asphalt", "background": "yellow", "minimum": 4.5, "use": "primary action" },
    { "foreground": "text", "background": "ground", "minimum": 4.5, "use": "body text" },
    { "foreground": "muted", "background": "ground", "minimum": 4.5, "use": "secondary text" },
    {
      "foreground": "muted",
      "background": "surface",
      "minimum": 4.5,
      "use": "secondary text on cards"
    },
    {
      "foreground": "blue",
      "background": "surface",
      "minimum": 4.5,
      "use": "links and secondary buttons"
    },
    { "foreground": "blue", "background": "ground", "minimum": 4.5, "use": "links on the page" },
    { "foreground": "red", "background": "surface", "minimum": 4.5, "use": "error text" },
    {
      "foreground": "red",
      "background": "ground",
      "minimum": 4.5,
      "use": "error text on the page"
    },
    { "foreground": "text", "background": "yellow-tint", "minimum": 4.5, "use": "warning notice" },
    { "foreground": "text", "background": "red-tint", "minimum": 4.5, "use": "error notice" },
    { "foreground": "text", "background": "green-tint", "minimum": 4.5, "use": "sent chip" },
    { "foreground": "text", "background": "blue-tint", "minimum": 4.5, "use": "information chip" },
    { "foreground": "border", "background": "surface", "minimum": 3, "use": "control border" },
    {
      "foreground": "border",
      "background": "ground",
      "minimum": 3,
      "use": "control border on the page"
    },
    { "foreground": "green", "background": "green-tint", "minimum": 3, "use": "chip icon" },
    { "foreground": "red", "background": "red-tint", "minimum": 3, "use": "chip icon" },
    { "foreground": "blue", "background": "blue-tint", "minimum": 3, "use": "chip icon" },
    { "foreground": "yellow", "background": "asphalt", "minimum": 3, "use": "focus halo on dark" },
    {
      "foreground": "asphalt",
      "background": "surface",
      "minimum": 3,
      "use": "focus outline on light"
    }
  ],
  "font": {
    "latin": "'Barlow', system-ui, sans-serif",
    "arabic": "'Noto Sans Arabic', 'Barlow', system-ui, sans-serif"
  },
  "lineHeight": { "latin": 1.4, "latin-tight": 1.15, "arabic": 1.7, "arabic-tight": 1.5 },
  "size": { "xs": 0.875, "sm": 0.9375, "md": 1.0625, "lg": 1.25, "xl": 1.5, "2xl": 2, "3xl": 2.75 },
  "space": { "1": 0.25, "2": 0.5, "3": 0.75, "4": 1, "5": 1.5, "6": 2, "7": 3, "8": 4 },
  "radius": { "sm": 0.375, "md": 0.625, "lg": 0.875, "xl": 1.375 },
  "target": { "min": 2.75, "large": 3.5 },
  "motion": { "fast": "120ms" }
}
