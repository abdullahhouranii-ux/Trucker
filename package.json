{
  "name": "trucker",
  "private": true,
  "description": "Trucker freight platform workspace. Foundation slice only: no business modules.",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "db:check": "npm run db:check -w @trucker/api",
    "db:migrate": "npm run db:migrate -w @trucker/api",
    "db:status": "npm run db:status -w @trucker/api",
    "start:api": "npm run start -w @trucker/api",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run db:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
