{
  "name": "trucker",
  "private": true,
  "description": "Trucker freight platform workspace. Foundation only: API and web shell, no business modules.",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present && npm run test:tools",
    "test:tools": "node --test tools/dev/lib.test.mjs",
    "db:check": "npm run db:check -w @trucker/api",
    "db:migrate": "npm run db:migrate -w @trucker/api",
    "db:status": "npm run db:status -w @trucker/api",
    "db:app-role": "npm run db:app-role -w @trucker/api",
    "db:fixtures": "npm run db:fixtures -w @trucker/api",
    "start:api": "npm run start -w @trucker/api",
    "versions": "node tools/dev/versions.mjs",
    "dev:env": "node tools/dev/env.mjs",
    "dev:doctor": "node tools/dev/doctor.mjs",
    "dev:db:up": "node tools/dev/db.mjs up",
    "dev:db:down": "node tools/dev/db.mjs down",
    "dev:db:reset": "node tools/dev/db.mjs reset",
    "dev:db:status": "node tools/dev/db.mjs status",
    "dev:migrate": "node tools/dev/with-env.mjs npm run db:migrate",
    "dev:app-role": "node tools/dev/with-env.mjs npm run db:app-role",
    "dev:fixtures": "node tools/dev/with-env.mjs npm run db:fixtures",
    "dev:verify": "node tools/dev/with-env.mjs npm run verify",
    "dev:api": "npm run build -w @trucker/api && node tools/dev/with-env.mjs npm run start:api",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run db:check && npm run test",
    "start:web": "npm run start -w @trucker/web",
    "test:browser": "npm run build -w @trucker/api && npm run build -w @trucker/web && npm run test:browser -w @trucker/web",
    "db:mark": "npm run db:mark -w @trucker/api",
    "db:settings": "npm run db:settings -w @trucker/api --",
    "dev:mark": "node tools/dev/with-env.mjs npm run db:mark",
    "dev:settings": "node tools/dev/with-env.mjs npm run db:settings --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
